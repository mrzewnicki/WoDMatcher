  "Thin-Blood Alchemy": {
    "book": "Vampire,_The_Masquerade_V5_Corebook_Extended",
    "general_rules": {
      "requirements": "All formulae require vitae from the Alchemist and human blood of the correct Resonance.",
      "power_level": "“Power level” refers to the level of Thin-Blood Alchemy involved, not the level of the Discipline power being counterfeited.",
      "distillation_cost": "One Rouse Check.",
      "activation_cost": "The activation cost is the same as using the counterfeited power normally: free or the required number of additional Rouse Checks.",
      "distillation_results": {
        "2_successes": "Power weak, fluky, or late in happening",
        "4_successes": "Power works as intended",
        "6_successes": "Power increased in effect"
      },
      "learning": "Learning a new formula requires research time. A character receives one formula for free for each dot in Thin-Blood Alchemy and can purchase additional formulae with experience and experimentation.",
      "activation": "The Alchemist can activate one power per turn."
    },
    "distillation_methods": {
      "athanor_corporis": "The Alchemist uses their own body as the alchemical furnace. Distillation uses Stamina + Alchemy and a Rouse Check. Only one power can be active at a time, and a new power must be distilled before it can be activated.",
      "calcinatio": "The Alchemist uses a human body as the athanor, adjusting the subject’s biophysical state through emotional pressure and spoken incantations. Distillation uses Manipulation + Alchemy. The Alchemist later drinks the vessel’s blood to use the power.",
      "fixatio": "The Alchemist uses a conventional athanor such as a kiln, furnace, meth cooker, or repurposed propane tank. Distillation uses Intelligence + Alchemy. The resulting formulae are fixed and can be carried and imbibed later."
    },
    "levels": {
      "1": {
        "far_reach": {
          "name": "Far Reach",
          "activation_cost": "One Rouse Check",
          "dice_pools": [
